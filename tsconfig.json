{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "types/**/*.d.ts",
    "scripts/**/*.ts",
    "scripts/**/*.js",
    "studio/**/*.ts",
    "studio/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "sources"
  ]
}
