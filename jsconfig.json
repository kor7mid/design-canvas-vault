{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "studio/**/*.js",
    "scripts/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "sources"
  ]
}
